/* 玄玖灵犀 NT-Xhex · 单页样式
 * 设计规范（色阶/圆角/阴影/间距/字号/动效/通用组件/线性图标/固定导航栏 .nt-nav）
 * 全部来自 theme.wxss（单一真源 modules/UIModule/theme.css，由 tools/sync-mp.js 生成）。
 * 本文件只写「本页布局结构 + 各视图槽位」，不重复定义 token / 组件，确保三端视觉一致。
 *
 * 布局铁律（统一标准，见 theme.wxss）：
 *   · 顶部「唯一」固定导航栏 = .nt-nav（左槽内容 + 居中标题 + 右槽），四视图共用同一组件，壳不重写规格。
 *   · 首页左槽=「关于」；结果/关于/二级页左槽=返回「‹」（源 后退.svg 放大 13×26pt）。下方不设导航栏。
 *   · 底部两行信息「随页面滚动、不固定」：仅首页显示备案号+版权；其余页显示免责声明+版本号（在滚动区内）。
 */

/* 页面：纵向弹性布局（根节点满高由 theme.wxss 基规则保证，.hero/.res 等 flex:1 才能撑满居中；
 * 顶部安全区由 JS 行内 padding-top 注入到 .nt-nav） */
.page {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--nt-bg);
  color: var(--nt-ink);
  box-sizing: border-box;
}

/* ========== 首页 ========== */
/* 空态：Logo 72×80.6 + 玄玖灵犀 22.9pt/600 + 搜索胶囊（1.3pt 描边/内文15.6pt/放大镜 22pt）+ 免责 12.5pt 纯黑 */
.hero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 32px; }
.hero-logo { width: 72px; height: 80.4px; }
.hero-title {
  margin-top: 16px;
  font-size: var(--fs-xl); font-weight: var(--fw-mid);
  letter-spacing: 1.6px; line-height: 1.15;
}
.hero-pill { margin-top: 16px; width: 272px; max-width: 100%; }
.hero-disclaimer { margin-top: 16px; font-size: var(--fs-note); font-weight: var(--fw-mid); color: var(--nt-foot); text-align: center; }

/* 页脚：备案号 + 版权（仅首页；原型 @24,798 354×30 两行 12pt/黑30% 行高15pt，距底 46pt） */
.foot { padding: 16px 24px 46px; text-align: center; flex-shrink: 0; }
.foot-icp { display: block; font-size: var(--fs-note); font-weight: var(--fw-mid); color: var(--nt-foot); line-height: 15px; }
.foot-copy { display: block; font-size: var(--fs-note); font-weight: var(--fw-mid); color: var(--nt-foot); line-height: 15px; }

/* ========== 视图容器（.home/.res/.ab/.dl 同规格：flex 列、撑满 stage 层；底部条 flex-shrink:0 固定、上方留白一致）========== */
.home, .res, .ab, .dl { flex: 1; display: flex; flex-direction: column; min-height: 0; }

/* scroll-view 在 flex 列里必须 flex:1 + min-height:0 + height:0（基线），否则拿不到确定性高度无法滚动 */
.res-body { flex: 1; min-height: 0; height: 0; padding: 0 24px; box-sizing: border-box; }
.ab-body { flex: 1; min-height: 0; height: 0; padding: 0 24px; box-sizing: border-box; }
.dl-body { flex: 1; min-height: 0; height: 0; padding: 0 24px; box-sizing: border-box; }

/* 结果页：两张正文范围卡（卡间 8pt 节奏）+ 内部分节段落（左 2px 竖线标记 + 15pt 顶格） */
.res-body .nt-dl-card + .nt-dl-card { margin-top: 8px; }
.res-body .nt-setfoot { margin-top: 24px; }
.res-block { margin-bottom: 12px; }
.res-block + .res-block { padding-top: 12px; border-top: 0.8px solid var(--nt-line); }
.res-block-label { display: block; font-size: var(--fs-note); font-weight: var(--fw-mid); color: var(--nt-text-2); letter-spacing: 0.4px; margin-bottom: 4px; }

/* 结果页底部：再问一个（返回输入页） */
.res-bar { display: flex; justify-content: center; padding: 12px 16px; }
.res-again { width: 100%; max-width: 320px; }

/* 关于页：品牌区居中 + 设置区下方留白 + 底部说明节奏（视觉走 theme.wxss .nt-setlist/.nt-setfoot） */
.ab-body .nt-setlist { margin-bottom: 8px; }
.ab-body .nt-setfoot { margin-top: 24px; }
.ab-brand { display: flex; flex-direction: column; align-items: center; padding: 32px 0 20px; }
.ab-brand-logo { width: 72px; height: 80.4px; }
.ab-brand-name { margin-top: 12px; font-size: var(--fs-xl); font-weight: var(--fw-mid); letter-spacing: 1.6px; }
.ab-brand-sub { margin-top: 8px; font-size: var(--fs-note); font-weight: var(--fw-mid); color: var(--nt-foot); letter-spacing: 0.8px; }

/* 二级页：正文卡内首条不额外留顶距 + 底部说明节奏 */
.dl-body .nt-dl-item.first .nt-dl-h1 { margin-top: 0; }
.dl-body .nt-setfoot { margin-top: 24px; }

/* ========== 响应式（规范 §6.2；WXSS 会忽略 @media，无害）========== */
@media screen and (min-width: 768px) {
  .page { max-width: 640px; margin: 0 auto; box-shadow: 0 0 0 0.8px var(--nt-line); }
}
@media screen and (min-width: 1024px) {
  .page { max-width: 720px; }
}
